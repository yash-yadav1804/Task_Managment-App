# ============================================================
# Task Management System — Environment Variable Template
# ============================================================
# Copy this file to .env and fill in your real values.
# NEVER commit your actual .env file.
# ============================================================


# ---- DATABASE ---------------------------------------------
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/task_management"


# ---- JWT AUTHENTICATION -----------------------------------
# A long, random secret string used to sign JWT tokens
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="replace-this-with-a-long-random-secret-string"

# JWT token expiry duration (e.g. 7d = 7 days, 1h = 1 hour)
JWT_EXPIRES_IN="7d"


# ---- BACKEND SERVER ---------------------------------------
# Port the NestJS server listens on
PORT=3001

# Node environment (development | production | test)
NODE_ENV="development"

# Frontend URL — used for CORS configuration
CLIENT_URL="http://localhost:3000"


# ---- FRONTEND (Next.js) -----------------------------------
# Base URL of the backend API — must be prefixed with NEXT_PUBLIC_ to expose to browser
NEXT_PUBLIC_API_URL="http://localhost:3001"


# ---- GOOGLE OAUTH (optional — implement if time permits) --
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:3001/auth/google/callback"


# ---- COOKIE SETTINGS (production) -------------------------
# Set to true in production when using HTTPS
COOKIE_SECURE="false"

# SameSite cookie policy (Strict | Lax | None)
COOKIE_SAME_SITE="Lax"
